+SYM_CODE_START(c5_boot_trap)
+	/* No stack, gp or BSS assumptions; retain cause/PC for debugger inspection. */
+	csrci CSR_STATUS, 8
+	csrr s0, CSR_CAUSE
+	csrr s1, CSR_EPC
+	csrr s2, CSR_TVAL
+	li t0, 0x6000f004
+	li t1, 1000000
