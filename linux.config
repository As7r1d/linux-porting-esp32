CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_ARCH_RV64I is not set
# CONFIG_MMU is not set
CONFIG_RISCV_M_MODE=y
# CONFIG_SMP is not set
CONFIG_RISCV_ISA_C=y
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_OF=y
CONFIG_TTY=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_BINFMT_FLAT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BASE_SMALL=y
CONFIG_SLUB_TINY=y
CONFIG_LOG_BUF_SHIFT=12
# CONFIG_MODULES is not set
# CONFIG_BLOCK is not set
# CONFIG_NET is not set
# CONFIG_KALLSYMS is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
CONFIG_ESP32C5_BOOTSTRAP=y
CONFIG_CMDLINE="earlycon=esp32c5usb console=ttyCUSB0 loglevel=7 nohlt root=mtd:rootfs rootfstype=cramfs ro init=/init"
CONFIG_CMDLINE_FORCE=y
CONFIG_ESP32C5_MEMORY_CHECKPOINT=y
CONFIG_ESP32C5_IRQ_CHECKPOINT=y
CONFIG_ESP32C5_TIME_CHECKPOINT=y
# CONFIG_HZ_250 is not set
CONFIG_HZ_100=y
CONFIG_ESP32C5_SCHED_CHECKPOINT=y
CONFIG_ESP32C5_USER_CHECKPOINT=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_ESP32C5_TTY_CHECKPOINT=y
CONFIG_ESP32C5_LIBC_CHECKPOINT=y
CONFIG_ESP32C5_SHELL_CHECKPOINT=y

CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK_TIME=y

# Independent read-only rootfs. The Flash loader stages it in reserved PSRAM.
# This is a ROM mapping, deliberately without write/erase operations.
CONFIG_MTD=y
CONFIG_MTD_ROM=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_CRAMFS=y
CONFIG_CRAMFS_MTD=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_FS_WRITEBUFFER=y
